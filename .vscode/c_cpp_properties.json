{
  "version": 4,
  "configurations": [
    {
      "name": "Linux-GCC-C11",
      "compilerPath": "/usr/local/bin/gcc",
      "compilerArgs": ["-std=c11", "-Wall", "-Wextra", "-Wpedantic"],
      "cStandard": "c11",
      "intelliSenseMode": "${default}",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/lib",
        "${workspaceFolder}/src"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/src",
          "${workspaceFolder}/lib",
          "${workspaceFolder}/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
